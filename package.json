{
  "name": "agrimind-merged",
  "version": "1.0.0",
  "description": "AgriMind — Unified Smart Poultry Health, Trade & Financial Intelligence Platform",
  "scripts": {
    "build": "cd app/frontend && npm install --include=dev && npm run build",
    "install:all": "cd app/backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd app/backend && node server.js",
    "dev:frontend": "cd app/frontend && npm run dev",
    "build:frontend": "cd app/frontend && npm run build",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "cd app/backend && node server.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vercel": "^60.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
