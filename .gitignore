# Dependencies
node_modules/
**/node_modules/

# Environment files and sensitive credentials (NEVER upload real secrets)
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example

# Build outputs
dist/
build/
**/dist/
**/build/

# Uploaded assets and user uploads (keep folder via .gitkeep)
app/backend/uploads/*
!app/backend/uploads/.gitkeep

# Logs and runtime data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
*.swp
*.swo

# Temp and cache directories
.cache/
.temp/
.tempmediaStorage/

.vercel
.env*

app/backend/scratch/
scratch/
